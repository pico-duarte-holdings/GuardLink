{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the recruiter dashboard (admin or recruiter).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the user."
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "recruiter"],
          "description": "Role of the user."
        },
        "slug": {
          "type": "string",
          "description": "Unique URL slug for the recruiter's personal link."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of when the user was created."
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "A potential recruit lead captured from the landing page.",
      "type": "object",
      "properties": {
        "recruiterId": {
          "type": "string",
          "description": "The UID of the recruiter this lead belongs to, or 'unassigned'."
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of when the lead was captured."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the lead."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the lead."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the lead."
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the lead."
        },
        "age": {
          "type": "string",
          "description": "Age of the lead."
        },
        "education": {
          "type": "string",
          "description": "Education level of the lead."
        },
        "interest": {
          "type": "string",
          "description": "Military interest level (Enlisted, Officer, etc.)."
        },
        "mos": {
          "type": "string",
          "description": "Military Occupational Specialty (MOS) of interest."
        },
        "source": {
          "type": "string",
          "description": "Source of the lead (e.g., Instagram, Campus)."
        },
        "message": {
          "type": "string",
          "description": "Additional message from the lead."
        },
        "status": {
          "type": "string",
          "enum": ["New", "Contacted", "Qualified", "Scheduled"],
          "description": "Current recruitment status of the lead."
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "element": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "type": { "type": "string", "enum": ["click", "view"] }
            }
          },
          "description": "Log of user interactions on the website before submission."
        }
      },
      "required": ["timestamp", "firstName", "lastName", "email", "phone", "status"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "A user who has subscribed for more information.",
      "type": "object",
      "properties": {
        "recruiterId": {
          "type": "string",
          "description": "The UID of the recruiter this subscription belongs to, or 'unassigned'."
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of the subscription."
        },
        "name": {
          "type": "string",
          "description": "Full name of the subscriber."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the subscriber."
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the subscriber."
        },
        "optIn": {
          "type": "boolean",
          "description": "Whether the user opted in to receive more information."
        }
      },
      "required": ["timestamp", "name", "email", "phone", "optIn"]
    },
    "PreApprovedUser": {
      "title": "PreApprovedUser",
      "description": "A user who has been pre-approved by an admin to join as a recruiter.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the pre-approved user."
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the pre-approved user."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "recruiter"],
          "description": "Role assigned to the pre-approved user."
        },
        "slug": {
          "type": "string",
          "description": "Unique URL slug for the recruiter's personal link."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of when the pre-approval was created."
        }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/pre_approved_users/{email}": {
      "schema": "PreApprovedUser",
      "description": "Collection of pre-approved users, keyed by email."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of recruiter and admin profiles."
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of recruitment leads."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Collection of newsletter/info subscriptions."
    }
  }
}
